{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stroke",
  "version": "0.4.1",
  "identifier": "com.broisnischal.stroke",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "ZFc1MGNuVnpkR1ZrSUdOdmJXMWxiblE2SUcxcGJtbHphV2R1SUhCMVlteHBZeUJyWlhrNklERXlPREV3TXpsRlFUQTBOamd3UmprS1VsZFVOV2RGWVdkdVowOUNSWFp2ZEZwWE5XeDJWMmxGU1VsYWFYUlBWMXB0ZFhscE5YcHVVM2wwUVdwdkx6VnZUelpaZFRsVGRVRUs=",
      "endpoints": [
        "https://github.com/broisnischal/stroke/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
