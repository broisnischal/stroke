# GitHub OAuth App credentials for the device-flow login feature.
# Copy this file to .env and fill in the values.
# Get these from: https://github.com/settings/developers → OAuth Apps → Stroke
#
# Both vars are required at build time — the build will fail loudly if missing.
# In CI (GitHub Actions), set these as repository secrets instead of a .env file.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
